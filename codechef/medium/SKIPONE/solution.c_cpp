#include <bits/stdc++.h>
using namespace std;

int main() {
    int t,n,k;
    cin >> t;
    while(t--){
        cin >> n >> k;
        int sum = 0 ;
        int y=0;
        int answer =0;
        
        for(int i=0; i<n; i++){
            int x;
            cin >> x;
            
            sum =sum + x;
            y= max(y,x);
            
            if(sum - y <= k){
                answer = i+1;
            }
            
        }
        cout << answer << endl;
    }
	// your code goes here

}
