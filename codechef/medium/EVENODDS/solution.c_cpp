#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, odd = 0;
        int A[100];

        cin >> N;

        for (int i = 0; i < N; i++) {
            cin >> A[i];

            if (A[i] % 2 != 0)
                odd++;
        }

        if (odd % 2 == 0)
            cout << N << endl;
        else
            cout << N - 1 << endl;
    }

    return 0;
}