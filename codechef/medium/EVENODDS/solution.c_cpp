#include <bits/stdc++.h>
using namespace std;

int main() {
int t;
cin >> t;

while (t--) {
    int n;
    cin >> n;

    int a[101];

    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    int ans = 0;

    for (int i = 0; i < n; i++) {
        int count = 0;

        for (int j = i; j < n; j++) {

            if (a[j] % 2 != 0) {
                count++;
            }

            if (count % 2 == 0) {
                int len = j - i + 1;

                if (len > ans) {
                    ans = len;
                }
            }
        }
    }

    cout << ans << endl;
}

return 0;

}