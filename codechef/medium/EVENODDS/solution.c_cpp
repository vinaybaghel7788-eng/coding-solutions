#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, A[100];
        cin >> N;

        int first = -1, last = -1;

        for (int i = 0; i < N; i++) {
            cin >> A[i];

            if (A[i] % 2 != 0) {
                if (first == -1)
                    first = i;

                last = i;
            }
        }

        if (first == -1 || (first == last)) {
            cout << (first == -1 ? N : N - 1) << endl;
        }
        else {
            cout << max(N - first - 1, last) << endl;
        }
    }

    return 0;
}