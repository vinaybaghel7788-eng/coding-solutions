#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, S;
        cin >> N >> S;

        if (S > 4 * N || S < -N) {
            cout << -1 << '\n';
        }
        else if (S >= 0) {
            if (S % 4 == 0) {
                cout << S / 4 << '\n';
            } else {
                cout << -1 << '\n';
            }
        }
        else {
            cout << -S << '\n';
        }
    }

    return 0;
}