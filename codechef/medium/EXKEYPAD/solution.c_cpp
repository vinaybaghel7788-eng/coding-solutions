#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        long long N;
        int D;
        cin >> N >> D;

        string s = to_string(N);

        while (true) {
            bool found = false;

            for (int i = 0; i < s.size(); i++) {
                if (s[i] == char('0' + D)) {
                    s[i]++;
                    for (int j = i + 1; j < s.size(); j++) {
                        s[j] = '0';
                    }
                    found = true;
                    break;
                }
            }

            if (!found) {
                cout << s << '\n';
                break;
            }

            for (int i = s.size() - 1; i >= 0; i--) {
                if (s[i] > '9') {
                    if (i == 0) {
                        s = '1' + string(s.size(), '0');
                        break;
                    }
                    s[i] = '0';
                    s[i - 1]++;
                }
            }
        }
    }

    return 0;
}