#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, D;
        cin >> N >> D;

        int x = N;

        while (true) {
            string s = to_string(x);

            if (s.find(char('0' + D)) == string::npos) {
                cout << x << '\n';
                break;
            }

            x++;
        }
    }

    return 0;
}