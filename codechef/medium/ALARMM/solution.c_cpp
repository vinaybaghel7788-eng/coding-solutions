#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, K;
        cin >> N >> K;

        string S;
        cin >> S;

        int alarms = 0;
        int i = 0;

        while (i < N) {
            if (S[i] == '1') {
                int pos = min(N - 1, i + K);

                alarms++;

                i = pos + 1;
            } else {
                i++;
            }
        }

        cout << alarms << endl;
    }

    return 0;
}