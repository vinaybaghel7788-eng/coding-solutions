#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while(t--){
        int n;
        string a,b;
        cin >> n;
        cin >> a >> b;
        int aA = count(a.begin(),a.end(),'a');
        int bB = count(b.begin(),b.end(),'a');
        
        if(aA == n-bB){
            cout << "yes" << endl;
        } else{
            cout << "no" << endl;
        }
        
        
    }
    return 0;
	// your code goes here

}
