#include <bits/stdc++.h>
using namespace std;

int main() {
    int t,n;
    cin >> t;
    while(t--){
        cin >> n;
        int odd =0, even =0;
        
        for(int i =0; i<n; i++){
            int x;
            cin >> x;
            
            if(x % 2 == 0){
                even++;
            } else {
                odd++;
            }
        }
        int ans = 2*min(odd,even) + 1;
        
        ans = min(ans,n);
        
        cout << ans << endl;
    }
	

}
