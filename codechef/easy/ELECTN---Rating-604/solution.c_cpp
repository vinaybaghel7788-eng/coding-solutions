#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while(t--){
        int n,x;
        cin >> n >> x;
        
        int eligible_count =0;
        for(int i=0; i<n; i++){
            int age;
            cin >> age;
            if(age>=x){
                eligible_count++;
            }
        }
            cout << eligible_count << endl;
}
return 0;

}
