#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while(t--){
        int x,a,b;
        cin  >> x >> a >> b;
        int total_points = a+2*b;
        if(total_points >= x){
            cout << "Qualify" << endl;
        } else{
            cout << "notQualify" << endl;
        }
    }
    return 0;
    
