#include <bits/stdc++.h>
using namespace std;

int main() {
    int t,x,a,b;
    cin >> t;
    while(t--){
        cin >> x >> a >> b;
        int c = 1*a + 2*b;
        
        if(c>=x){
            cout << "qualify" << endl;
        } else{
            cout << "not qualify" << endl;
        }
    }
    return 0;
	// your code goes here

}
