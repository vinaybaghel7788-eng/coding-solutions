#include <iostream>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	     int x,y;
	     cin>>x>>y;
	     
	    int m=(500-x*2)+(1000-(x+y)*4);
	    int n=(500-(x+y)*2)+(1000-y*4);
	    
	    if(m>n){
	        cout<<m<<endl;
	    }
	    else{
	        cout<<n<<endl;
	    }
	    
	}
	return 0;
}
