#include <bits/stdc++.h>
using namespace std;

int main() {
    int t,n,x;
    cin >> t;
    while(t--){
        cin >> n >> x;
        if(n<=x){
            cout << "0" << endl;
        } else{
           int y = n-x;
           int packets = (y+3)/4;
           cout << packets << endl;
        }
    }
	// your code goes here

}
