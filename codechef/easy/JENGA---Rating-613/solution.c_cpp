#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while(t--){
        int n,x;
        cin >> n >> x;
        if(n%x==0 ||x%n==0 ){
            cout << "yes" << endl;
        } else(n>x) {
            cout << "no" << endl;
        }
    }
    return 0;
	// your code goes here

}
