#include <iostream>
using namespace std;

void factorial(int n) {
    int result[200];
    int size = 1;

    result[0] = 1;

    for (int i = 2; i <= n; i++) {
        int carry = 0;

        for (int j = 0; j < size; j++) {
            int value = result[j] * i + carry;

            result[j] = value % 10;
            carry = value / 10;
        }

        while (carry) {
            result[size] = carry % 10;
            carry /= 10;
            size++;
        }
    }

    // Print from most significant digit
    for (int i = size - 1; i >= 0; i--) {
        cout << result[i];
    }

    cout << endl;
}

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        factorial(n);
    }

    return 0;
}