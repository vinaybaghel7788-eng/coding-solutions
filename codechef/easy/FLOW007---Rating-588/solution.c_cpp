#include <bits/stdc++.h>
using namespace std;

int main() {
    int t,n;
    cin >> t;
    while(t--){
        cin >> n;
        int rev =0;
        while(n>0){
            int digit = n%10;
            rev = rev*10 + digit;
            n /= 10;
        }
        cout << rev << endl;
    }
    
	// your code goes here

}
