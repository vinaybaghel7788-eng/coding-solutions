#include <iostream>
#include <cmath>
#include <algorithm>

using namespace std;

int main() {

    int n;
    cin >> n;

    int cumulative1 = 0;
    int cumulative2 = 0;
    int max_lead = 0;
    int winner = 0;

    for (int i = 0; i < n; i++) {
        int s, t;
        cin >> s >> t;

        cumulative1 += s;
        cumulative2 += t;

        
        int current_lead = abs(cumulative1 - cumulative2);

        if (current_lead > max_lead) {
            max_lead = current_lead;
            if (cumulative1 > cumulative2) {
                winner = 1;
            } else {
                winner = 2;
            }
        }
    }

    cout << winner << " " << max_lead << "\n";

    return 0;
}